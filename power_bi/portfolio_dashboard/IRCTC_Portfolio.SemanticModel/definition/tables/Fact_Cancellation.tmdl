		lineageTag: 20e9d8bd-5077-5f2b-a0a8-600de8749882
		summarizeBy: none
		sourceColumn: RefundAmount

	partition Fact_Cancellation = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\Fact_Cancellation.csv"), [Delimiter = ",", Columns = 11, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"CancellationID", Int64.Type}, {"BookingID", Int64.Type}, {"JourneyDate", type date}, {"TrainKey", Int64.Type}, {"ClassKey", type text}, {"CancellationType", type text}, {"StatusAtCancellation", type text}, {"CancelledPassengers", Int64.Type}, {"OriginalFare", type number}, {"CancellationCharge", type number}, {"RefundAmount", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

