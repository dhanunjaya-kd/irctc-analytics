		lineageTag: 8257f52a-d05d-59a4-9458-85edb8b0255f
		summarizeBy: none
		sourceColumn: StatusAtCancellation

	column CancelledPassengers
		dataType: int64
		formatString: 0
		lineageTag: ef8b655c-a65b-596c-8e64-1ff45b3d51e2
		summarizeBy: none
		sourceColumn: CancelledPassengers

	column OriginalFare
		dataType: double
		formatString: #,0.00
		lineageTag: fd0b334b-5c7c-5ad8-bdbc-c59f92c9a56b
		summarizeBy: none
		sourceColumn: OriginalFare

	column CancellationCharge
		dataType: double
