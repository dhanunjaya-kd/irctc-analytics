model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Dim_Date","Dim_Train","Dim_Route","Dim_Class","Dim_BookingStatus","Dim_PassengerStatus","Fact_Booking","Fact_Passenger","Fact_ClassRun","Fact_TrainRun","Fact_Cancellation","Ref_KPI","Ref_RowCounts","Ref_Checks","Ref_ModelTables","DataFolder"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Date
ref table Dim_Train
ref table Dim_Route
ref table Dim_Class
ref table Dim_BookingStatus
ref table Dim_PassengerStatus
ref table Fact_Booking
ref table Fact_Passenger
ref table Fact_ClassRun
ref table Fact_TrainRun
ref table Fact_Cancellation
ref table Ref_KPI
ref table Ref_RowCounts
ref table Ref_Checks
ref table Ref_ModelTables
ref table 'KPI Selector'
ref table _Measures

ref cultureInfo en-US

